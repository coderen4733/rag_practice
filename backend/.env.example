# [신규] 백엔드 환경 변수 안내 파일
#  - 이 파일을 복사해서 같은 폴더에 .env 파일을 만든 뒤, 실제 값을 채워 넣으세요
#    (터미널 명령어: cp .env.example .env)
#  - ⚠️ 이 파일은 git에 올라가므로 실제 비밀번호/키를 절대 적지 마세요!
#  - 새 환경 변수를 추가하면 src/core/config.py 와 이 파일 모두에 추가해 주세요

# [필수] Postgres DB 접속 주소 (Supabase > Project Settings > Database > Connection string)
DB_URL=postgresql://<사용자>:<비밀번호>@<호스트>:5432/postgres

# [선택] Qdrant Vector DB 접속 주소 (아직 사용하는 코드 없음)
VECTOR_DB_URL=

# [선택] Redis 접속 주소 (아직 사용하는 코드 없음)
REDIS_URL=

# [선택] 실행되는 SQL을 콘솔에 출력할지 여부 (true/false, 기본값 false)
DB_ECHO=false

# [선택] CORS 허용 프론트엔드 주소 목록 (JSON 배열 형식, 기본값 ["http://localhost:3000"])
CORS_ORIGINS=["http://localhost:3000"]

# [수정] JWT(로그인 토큰) 관련 환경 변수 추가
#  - 기존: 없음 (config.py에 비밀키가 하드코딩되어 있었음)
#  - 변경: 비밀키는 반드시 .env에서 넣도록 변경 (32자 이상 필수)
#  - 비밀키 만드는 방법(터미널): python -c "import secrets; print(secrets.token_urlsafe(64))"
# [필수] 액세스 토큰 서명용 비밀키
ACCESS_TOKEN_SECRET=<32자 이상의 랜덤 문자열>
# [필수] 리프레시 토큰 서명용 비밀키 (액세스 토큰 비밀키와 다른 값 사용)
REFRESH_TOKEN_SECRET=<32자 이상의 랜덤 문자열>
# [선택] 토큰 서명 알고리즘 (기본값 HS256)
JWT_ALGORITHM=HS256
# [선택] 액세스 토큰 유효기간 (단위: 분, 기본값 30)
ACCESS_TOKEN_EXPIRE=30
# [선택] 리프레시 토큰 유효기간 (단위: 일, 기본값 1)
REFRESH_TOKEN_EXPIRE=1
