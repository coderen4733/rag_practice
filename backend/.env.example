# [신규] 백엔드 환경 변수 안내 파일
#  - 이 파일을 복사해서 같은 폴더에 .env 파일을 만든 뒤, 실제 값을 채워 넣으세요
#    (터미널 명령어: cp .env.example .env)
#  - ⚠️ 이 파일은 git에 올라가므로 실제 비밀번호/키를 절대 적지 마세요!
#  - 새 환경 변수를 추가하면 src/core/config.py 와 이 파일 모두에 추가해 주세요

# [필수] Postgres DB 접속 주소 (Supabase > Project Settings > Database > Connection string)
DB_URL=postgresql://<사용자>:<비밀번호>@<호스트>:5432/postgres

# [수정] Vector DB(Qdrant) 설정 - VECTOR_DB_URL이 필수값으로 변경됨
#  - 기존: [선택] VECTOR_DB_URL (아직 사용하는 코드 없음)
#  - 변경: 실제 연결 코드가 추가되어 VECTOR_DB_URL 필수, 나머지 설정 추가
# [필수] Qdrant 접속 주소 (Qdrant Cloud > Cluster > Endpoint)
VECTOR_DB_URL=https://<클러스터 주소>:6333
# [선택] Qdrant API 키 (Qdrant Cloud는 필수 / API 키 없는 자체 운영 Qdrant는 비워둠)
VECTOR_DB_API_KEY=
# [선택] 문서 벡터를 저장할 컬렉션 이름 (기본값 documents)
VECTOR_DB_COLLECTION=documents
# [선택] Qdrant 요청 제한 시간 (단위: 초, 기본값 10)
VECTOR_DB_TIMEOUT=10

# [수정] 임베딩 서버 설정 추가
#  - 기존: 없음
#  - 변경: 임베딩은 OpenAI 호환 API(/v1/embeddings)를 가진 별도 서버에 요청
#  - 개발용 임베딩 서버 실행: _deploy 폴더에서 docker compose up -d embedding
# [필수] 임베딩 서버 주소 (/v1 까지)
EMBEDDING_BASE_URL=http://localhost:8081/v1
# [선택] 임베딩 서버 API 키 (Ollama는 필요 없으므로 비워둠)
EMBEDDING_API_KEY=
# [선택] 임베딩 모델 이름 (기본값 bge-m3)
EMBEDDING_MODEL=bge-m3
# [선택] 벡터 차원 (기본값 1024, 모델을 바꾸면 반드시 함께 변경)
EMBEDDING_DIM=1024
# [선택] 한 번에 임베딩할 문장 수 (기본값 32)
EMBEDDING_BATCH_SIZE=32
# [선택] 임베딩 요청 제한 시간 (단위: 초, 기본값 60)
EMBEDDING_TIMEOUT=60

# Embedding Chunking 관련
# 업로드 파일 최대 크기 (단위: 바이트, 기본값 1048576 = 1MB)
DOCUMENT_MAX_FILE_SIZE=1048576
# 청크 크기 (단위: 글자 수, 기본값 500, 최소 100)
DOCUMENT_CHUNK_SIZE=500
# 청크 겹침 길이 (단위: 글자 수, 기본값 100, 청크 크기의 절반보다 작아야 함)
DOCUMENT_CHUNK_OVERLAP=100

# [선택] Redis 접속 주소 (아직 사용하는 코드 없음)
REDIS_URL=

# [선택] 실행되는 SQL을 콘솔에 출력할지 여부 (true/false, 기본값 false)
DB_ECHO=false

# [선택] CORS 허용 프론트엔드 주소 목록 (JSON 배열 형식, 기본값 ["http://localhost:3000"])
CORS_ORIGINS=["http://localhost:3000"]

# [수정] JWT(로그인 토큰) 관련 환경 변수 추가
#  - 기존: 없음 (config.py에 비밀키가 하드코딩되어 있었음)
#  - 변경: 비밀키는 반드시 .env에서 넣도록 변경 (32자 이상 필수)
#  - 비밀키 만드는 방법(터미널): python -c "import secrets; print(secrets.token_urlsafe(64))"
# [필수] 액세스 토큰 서명용 비밀키
ACCESS_TOKEN_SECRET=<32자 이상의 랜덤 문자열>
# [필수] 리프레시 토큰 서명용 비밀키 (액세스 토큰 비밀키와 다른 값 사용)
REFRESH_TOKEN_SECRET=<32자 이상의 랜덤 문자열>
# [선택] 토큰 서명 알고리즘 (기본값 HS256)
JWT_ALGORITHM=HS256
# [선택] 액세스 토큰 유효기간 (단위: 분, 기본값 30)
ACCESS_TOKEN_EXPIRE=30
# [선택] 리프레시 토큰 유효기간 (단위: 일, 기본값 1)
REFRESH_TOKEN_EXPIRE=1
