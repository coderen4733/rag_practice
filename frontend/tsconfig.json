// TypeScript 설정
//  - src 폴더의 코드를 엄격한(strict) 규칙으로 타입 검사하도록 설정
//  - npm run build 를 실행하면 먼저 이 설정으로 타입 검사(tsc --noEmit)를 한 뒤 빌드함
{
  "compilerOptions": {
    // 최신 자바스크립트 문법으로 검사 (실제 변환은 Vite가 담당)
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    // Vite 같은 번들러(bundler) 방식으로 import 경로를 해석
    "moduleResolution": "bundler",
    // React 17+ 방식의 JSX (파일마다 import React 를 쓰지 않아도 됨)
    "jsx": "react-jsx",
    // 엄격한 타입 검사 (null 가능성, 타입 누락 등을 모두 잡아냄)
    "strict": true,
    // 사용하지 않는 변수/매개변수가 있으면 에러
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // 타입 검사만 하고 파일은 만들지 않음 (파일 생성은 Vite가 담당)
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // import.meta.env 등 Vite 전용 기능의 타입 정보
    "types": ["vite/client"]
  },
  "include": ["src"]
}
